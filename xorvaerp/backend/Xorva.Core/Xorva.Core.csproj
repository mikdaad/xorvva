<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" />
    <!-- EF Core abstractions only (DbSet/IQueryable) so modules can own their entities
         and query via IXorvaDbContext without referencing Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <!-- DI abstractions so the IModule plug-in contract can register a module's services. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

</Project>
